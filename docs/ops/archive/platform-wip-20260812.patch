+    /**
+     * Sends a single batched Slack notification at the end of a multi-call AI job
+     * (e.g. PDF chunk embedding loop). Replaces per-chunk floods that would otherwise
+     * trip Slack webhook rate limits.
+     *
+     * <p>{@code estimatedCost} may be null when the caller has no pricing context;
+     * the message will then omit the cost line.
+     *
+     * @param username       authenticated user (or "system" / "anonymous")
+     * @param endpoint       human-readable endpoint label (e.g. "PDF Embedding (book='X')")
+     * @param callCount      number of underlying AI calls aggregated
+     * @param totalTokens    sum of estimated tokens across all calls
+     * @param estimatedCost  rough USD cost; nullable when unavailable
+     */
+    @Async
+    public void notifyAiUsageBatch(String username, String endpoint, int callCount,
+                                   long totalTokens, BigDecimal estimatedCost) {
+        if (!enabled) {
+            return;
+        }
+        // No-op: nothing actually happened. Avoid noise when callers
+        // unconditionally invoke at job completion.
+        if (callCount <= 0) {
+            return;
+        }
+
+        String timestamp = LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss"));
+        StringBuilder sb = new StringBuilder();
+        sb.append("AI Token Usage (Batch) — my-atlas\n");
+        sb.append("User: ").append(username).append('\n');
+        sb.append("Endpoint: ").append(endpoint).append('\n');
+        sb.append("Calls: ").append(callCount).append('\n');
+        sb.append(String.format("Estimated Tokens: ~%,d%n", totalTokens));
+        if (estimatedCost != null) {
+            sb.append(String.format("Estimated Cost: $%s%n",
+                    estimatedCost.setScale(4, RoundingMode.HALF_UP).toPlainString()));
+        }
+        sb.append("Time: ").append(timestamp);
+
+        try {
+            restTemplate.postForEntity(webhookUrl, Map.of("text", sb.toString()), String.class);
+            log.debug("Slack AI usage batch notification sent for user={} calls={}", username, callCount);
+        } catch (Exception e) {
+            log.warn("Failed to send Slack batch notification: {}", e.getMessage());
+        }
+    }
 }
