# 에이전트 워커 환경변수 (복사: cp .env.example .env)

# 대상 my-atlas 백엔드 (워커가 claim/context/results/complete 호출)
BACKEND_URL=http://localhost:8085

# 백엔드 로그인 (JWT 획득용, 시드 계정)
AGENT_WORKER_USERNAME=
AGENT_WORKER_PASSWORD=

# Claude (실행 루프의 판단·판정)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-4-5-20251001

# 브라우저 (docker 컨테이너면 true 권장)
HEADLESS=true

# TC step당 최대 액션 시도 (토큰/시간 상한)
MAX_STEP_ACTIONS=4
